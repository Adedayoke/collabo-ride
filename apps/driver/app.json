{
  "expo": {
    "name": "Collabo Driver",
    "slug": "collabo-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "collabodriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.collaboride.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.collaboride.driver"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0F1412"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "../../packages/ui/fonts/DMSans_400Regular.ttf",
            "../../packages/ui/fonts/DMSans_500Medium.ttf",
            "../../packages/ui/fonts/DMSans_600SemiBold.ttf",
            "../../packages/ui/fonts/DMSans_700Bold.ttf",
            "../../packages/ui/fonts/Inter_400Regular.ttf",
            "../../packages/ui/fonts/Inter_500Medium.ttf",
            "../../packages/ui/fonts/Inter_600SemiBold.ttf",
            "../../packages/ui/fonts/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
