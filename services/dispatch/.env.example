APP_ENV=development
SERVICE_NAME=dispatch
PORT=8083
LOG_LEVEL=info
# Same value in every service. Generate a real one with: openssl rand -hex 32
GATEWAY_CONTEXT_KEY=dev-only-gateway-context-key-change-me-0123456789
# This service's own role; it can only reach the dispatch schema.
DATABASE_URL=postgres://dispatch:dispatch-dev-password@localhost:5432/collabo
VALKEY_LIVE_URL=redis://:valkey-live-dev-password@localhost:6379
VALKEY_DURABLE_URL=redis://:valkey-durable-dev-password@localhost:6380
OSRM_URL=http://localhost:5000
