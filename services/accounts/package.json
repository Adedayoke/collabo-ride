{
  "name": "@collabo/accounts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxlint --fix && oxfmt",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@collabo/service-kit": "workspace:*",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@collabo/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.4"
  }
}
