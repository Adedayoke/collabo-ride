NODE_ENV=development
SERVICE_NAME=payments
PORT=8084
LOG_LEVEL=info
# Same value in every service. Generate a real one with: openssl rand -hex 32
GATEWAY_CONTEXT_KEY=dev-only-gateway-context-key-change-me-0123456789
# This service's own role; it can only reach the payments schema.
DATABASE_URL=postgres://payments:payments-dev-password@localhost:5432/collabo
VALKEY_DURABLE_URL=redis://:valkey-durable-dev-password@localhost:6380
