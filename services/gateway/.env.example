JWT_AUDIENCE=collabo-api
ACCOUNTS_URL=http://localhost:8081
TRIP_URL=http://localhost:8082
DISPATCH_URL=http://localhost:8083
PAYMENTS_URL=http://localhost:8084
NOTIFICATIONS_URL=http://localhost:8085
