{
  "name": "@collabo/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "tsconfig.node.json",
    "oxlint.json",
    "oxlint.react.json",
    "oxlint.ui.json",
    "lint/**"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings lint && oxfmt --check",
    "lint:css": "node lint/css-drift.ts",
    "format": "oxlint --fix lint && oxfmt"
  },
  "dependencies": {
    "eslint-plugin-i18next": "6.1.5",
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "~6.0.3",
    "vitest": "5.0.4"
  }
}
