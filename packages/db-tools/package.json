  },
  "devDependencies": {
    "@collabo/config": "workspace:*",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.4"
  }
}
