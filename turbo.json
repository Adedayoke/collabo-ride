{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "PATH", "HOME", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "SYSTEMROOT", "TEMP", "TMP",
    "GOPATH", "GOCACHE", "GOMODCACHE", "GOFLAGS", "UV_CACHE_DIR", "UV_PYTHON"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!.env", "!**/*.test.*", "!tests/**"],
      "outputs": ["dist/**", "bin/**"],
      "env": ["EXPO_PUBLIC_*", "VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    }
  }
}
