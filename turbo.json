{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "PATH",
    "HOME",
    "USERPROFILE",
    "APPDATA",
    "LOCALAPPDATA",
    "SYSTEMROOT",
    "TEMP",
    "TMP",
    "GOPATH",
    "GOCACHE",
    "GOMODCACHE",
    "GOFLAGS",
    "UV_CACHE_DIR",
    "UV_PYTHON"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!.env", "!**/*.test.*", "!tests/**"],
      "outputs": ["dist/**", "bin/**"],
      "env": ["EXPO_PUBLIC_*", "VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxfmtrc.json",
        "$TURBO_ROOT$/packages/config/oxlint*.json",
        "$TURBO_ROOT$/packages/config/lint/**"
      ]
    },
    "//#lint:root": {
      "inputs": ["$TURBO_DEFAULT$", "!apps/**", "!services/**", "!packages/**"]
    },
    "format": {
      "cache": false
    },
    "//#format:root": {
      "cache": false
    },
    "@collabo/console#dev": {
      "dependsOn": ["@collabo/ui#build"],
      "cache": false,
      "persistent": true
    }
  }
}
