# Copy to .env (gitignored). Local development values only; generate real
# secrets for the VPS (for example: openssl rand -hex 32).

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-password
POSTGRES_DB=collabo

# One login role per service (created by postgres-init on first start).
ACCOUNTS_DB_PASSWORD=accounts-dev-password
TRIP_DB_PASSWORD=trip-dev-password
DISPATCH_DB_PASSWORD=dispatch-dev-password
PAYMENTS_DB_PASSWORD=payments-dev-password
# Owns the payments schema and runs its migrations (postgres-init/02-payments-owner.sql).
PAYMENTS_OWNER_DB_PASSWORD=payments-owner-dev-password
NOTIFICATIONS_DB_PASSWORD=notifications-dev-password
FRAUD_DB_PASSWORD=fraud-dev-password

VALKEY_LIVE_PASSWORD=valkey-live-dev-password
VALKEY_DURABLE_PASSWORD=valkey-durable-dev-password

MINIO_ROOT_USER=collabo
MINIO_ROOT_PASSWORD=minio-dev-password

GATEWAY_CONTEXT_KEY=dev-only-gateway-context-key-change-me-0123456789

# Caddy site address. ":80" serves plain HTTP; set a domain on the VPS for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8000
